{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:agents:usage-read:v1.0",
  "title": "Safe agent usage response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "reservation_status", "reserved_cost_microusd", "settled_cost_microusd", "ledger"],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "reservation_status": {"type": ["string", "null"], "enum": [null, "reserved", "settled", "released"]},
    "reserved_cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000000},
    "settled_cost_microusd": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000000},
    "ledger": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "entry_type", "input_tokens", "output_tokens", "cost_microusd", "recorded_at"],
        "properties": {
          "record_id": {"type": "string", "format": "uuid"},
          "entry_type": {"enum": ["reserved", "settled", "released", "adjustment"]},
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "cost_microusd": {"type": "integer", "minimum": 0},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
