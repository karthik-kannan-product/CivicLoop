{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:agents:run-read:v1.0",
  "title": "Safe agent run read response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow_id", "event_revision_id", "package_hash", "routing_policy", "model_profile", "privacy_mode", "status", "attempt", "queued_at", "started_at", "finished_at", "failure_category", "trace", "usage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "format": "uuid"},
    "workflow_id": {"type": "string", "format": "uuid"},
    "event_revision_id": {"type": "integer", "minimum": 1},
    "package_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "routing_policy": {"$ref": "#/$defs/versioned_id"},
    "model_profile": {"$ref": "#/$defs/versioned_id"},
    "privacy_mode": {"enum": ["synthetic_full", "pilot_minimized", "disabled"]},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
    "queued_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "failure_category": {"type": ["string", "null"], "enum": [null, "budget_exhausted", "cancelled", "dependency_unavailable", "invalid_output", "provider_unavailable", "timeout"]},
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "span_count"],
      "properties": {
        "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "span_count": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "usage": {"$ref": "#/$defs/usage"}
  },
  "$defs": {
    "versioned_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost_microusd"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "cost_microusd": {"type": "integer", "minimum": 0, "maximum": 1000000000000}
      }
    }
  }
}
