{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:agents:agent-run:v1",
  "title": "Agent run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "workflow_id", "fixture_manifest_id", "model_profile_id", "status", "attempt", "queued_at", "started_at", "finished_at", "failure_category", "telemetry"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "format": "uuid", "maxLength": 36 },
    "workflow_id": { "type": "string", "format": "uuid", "maxLength": 36 },
    "fixture_manifest_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "model_profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "status": { "enum": ["queued", "running", "succeeded", "failed", "cancelled"] },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 10 },
    "queued_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "started_at": { "type": ["string", "null"], "format": "date-time", "maxLength": 40 },
    "finished_at": { "type": ["string", "null"], "format": "date-time", "maxLength": 40 },
    "failure_category": { "type": ["string", "null"], "enum": [null, "budget_exhausted", "cancelled", "dependency_unavailable", "invalid_output", "provider_unavailable", "timeout"] },
    "telemetry": { "$ref": "#/$defs/telemetry" }
  },
  "$defs": {
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "span_count"],
      "properties": {
        "trace_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "span_count": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
