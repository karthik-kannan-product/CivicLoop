{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:agents:model-profile:v1",
  "title": "Model profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "revision", "provider", "model", "purpose", "max_input_tokens", "max_output_tokens", "temperature", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "provider": { "enum": ["hermes", "groq", "openai"] },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,120}$", "maxLength": 120 },
    "purpose": { "enum": ["workflow", "evaluation_judge", "fallback"] },
    "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 10000000 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 40 }
  }
}
