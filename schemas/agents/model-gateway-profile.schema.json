{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:agents:model-gateway-profile:v1.0",
  "title": "Provider-neutral model gateway profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "model_alias",
    "base_url",
    "timeout_seconds",
    "budgets"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "model_alias": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$" },
    "base_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_cost_microusd"],
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_cost_microusd": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
      }
    }
  }
}
