{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:evaluations:result:v1",
  "title": "Evaluation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "example_id",
    "run_id",
    "evaluator",
    "evaluator_profile_id",
    "outcome",
    "score",
    "reason_codes",
    "summary",
    "created_at",
    "dataset",
    "example",
    "prompt",
    "policy",
    "evaluated_schema",
    "candidate",
    "judge",
    "rubric",
    "deterministic_checks",
    "usage",
    "latency_ms",
    "trace_id",
    "advisory_only"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "result_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "example_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 36
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "maxLength": 36
    },
    "evaluator": {
      "enum": [
        "deterministic",
        "llm_judge",
        "human_review"
      ]
    },
    "evaluator_profile_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]{2,63}$",
      "maxLength": 64
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "expected_output",
          "policy_violation",
          "schema_invalid",
          "tool_error",
          "timeout"
        ]
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "prompt": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 160
        },
        "version": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 1
        }
      },
      "required": [
        "reference",
        "version"
      ],
      "additionalProperties": false
    },
    "advisory_only": {
      "const": true
    },
    "rubric": {
      "type": "object",
      "properties": {
        "rubric_id": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 1
        }
      },
      "required": [
        "rubric_id",
        "version"
      ],
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "properties": {
        "example_id": {
          "type": "string",
          "maxLength": 36,
          "format": "uuid"
        }
      },
      "required": [
        "example_id"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 1
        },
        "dataset_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "dataset_id",
        "version"
      ],
      "additionalProperties": false
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "check": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "check",
          "passed"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    },
    "evaluated_schema": {
      "type": "object",
      "properties": {
        "schema_id": {
          "type": "string",
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "maxLength": 32
        }
      },
      "required": [
        "schema_id",
        "version"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "maxLength": 64
        },
        "version": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 1
        }
      },
      "required": [
        "policy_id",
        "version"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "output_tokens": {
          "type": "integer",
          "maximum": 10000000,
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "maximum": 10000000,
          "minimum": 0
        },
        "cost_microusd": {
          "type": "integer",
          "maximum": 1000000000000,
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_microusd"
      ],
      "additionalProperties": false
    },
    "judge": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "deterministic",
            "llm_judge",
            "human_review"
          ]
        },
        "profile_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{2,63}$",
          "type": [
            "string",
            "null"
          ]
        },
        "config_id": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]{2,63}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "latency_ms": {
      "type": "integer",
      "maximum": 3600000,
      "minimum": 0
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "maximum": 1000000,
          "minimum": 1
        },
        "candidate_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "candidate_id",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "deterministic"
          }
        }
      },
      "then": {
        "properties": {
          "judge": {
            "properties": {
              "profile_id": {
                "const": null
              },
              "kind": {
                "const": "deterministic"
              },
              "config_id": {
                "const": null
              }
            }
          },
          "evaluator_profile_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluator": {
            "const": "llm_judge"
          }
        }
      },
      "then": {
        "properties": {
          "judge": {
            "properties": {
              "profile_id": {
                "type": "string"
              },
              "kind": {
                "const": "llm_judge"
              },
              "config_id": {
                "type": "string"
              }
            }
          },
          "evaluator_profile_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}