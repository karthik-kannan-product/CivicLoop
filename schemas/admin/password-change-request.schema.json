{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:admin:password-change-request",
  "title": "Administrator password change",
  "type": "object",
  "additionalProperties": false,
  "required": ["current_password", "new_password"],
  "properties": {
    "current_password": { "type": "string", "minLength": 1, "maxLength": 4096, "writeOnly": true },
    "new_password": { "type": "string", "minLength": 12, "maxLength": 4096, "writeOnly": true }
  }
}
