{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:admin:recovery-challenge-request",
  "title": "Recovery-code challenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["recovery_code"],
  "properties": {
    "recovery_code": { "type": "string", "pattern": "^[A-Z2-7]{8}-[A-Z2-7]{26}$", "writeOnly": true }
  }
}
