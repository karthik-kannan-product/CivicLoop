{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:admin:session-list",
  "title": "Administrator session list",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessions"],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "device_label", "source_ip", "created_at", "authenticated_at", "last_activity_at", "mfa_verified_at", "absolute_expires_at", "expires_at", "revoked_at", "is_current"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "device_label": { "type": "string", "maxLength": 160 },
          "source_ip": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "authenticated_at": { "type": ["string", "null"], "format": "date-time" },
          "last_activity_at": { "type": ["string", "null"], "format": "date-time" },
          "mfa_verified_at": { "type": ["string", "null"], "format": "date-time" },
          "absolute_expires_at": { "type": ["string", "null"], "format": "date-time" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "revoked_at": { "type": ["string", "null"], "format": "date-time" },
          "is_current": { "type": "boolean" }
        }
      }
    }
  }
}
