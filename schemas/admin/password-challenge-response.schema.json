{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:admin:password-challenge-response",
  "title": "Administrator password challenge result",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "expires_at", "next_action"],
  "properties": {
    "stage": { "const": "password_verified" },
    "expires_at": { "type": "string", "format": "date-time" },
    "next_action": { "enum": ["enroll_totp", "verify_totp"] }
  }
}
