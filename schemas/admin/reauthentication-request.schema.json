{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicloop:schema:admin:reauthentication-request",
  "title": "Fresh administrator verification request",
  "type": "object",
  "additionalProperties": false,
  "required": ["password", "token"],
  "properties": {
    "password": { "type": "string", "minLength": 1, "maxLength": 4096, "writeOnly": true },
    "token": { "type": "string", "pattern": "^[0-9]{6}$", "writeOnly": true }
  }
}
