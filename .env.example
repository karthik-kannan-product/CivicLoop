CIVICLOOP_ENV=production
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=civicloop.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://civicloop.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
CIVICLOOP_DEMO_PASSWORD=replace-with-a-unique-demo-password
CIVICLOOP_ADMIN_IDENTITY_ENABLED=false
CIVICLOOP_IDENTITY_KEY_FILE=/run/secrets/civicloop-identity-keyring.json
# Required bind source for web/migrate. Use an absolute host path outside this checkout.
CIVICLOOP_IDENTITY_KEY_HOST_PATH=/srv/civicloop/secrets/identity-keyring.json
CIVICLOOP_INTEGRATIONS_ENABLED=false
CIVICLOOP_INTEGRATION_KEY_FILE=/run/secrets/civicloop-integration-keyring.json
# Required only with compose.integrations.yaml when integrations are enabled.
CIVICLOOP_INTEGRATION_KEY_HOST_PATH=/srv/civicloop/secrets/integration-keyring.json
CIVICLOOP_ADMIN_TRUSTED_PROXY_IPS=
DATABASE_URL=postgresql://civicloop:change-me@db:5432/civicloop
POSTGRES_DB=civicloop
POSTGRES_USER=civicloop
POSTGRES_PASSWORD=change-me
VALKEY_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/1
AGENT_MAX_CONCURRENCY=3
CELERY_WORKER_CONCURRENCY=1
WEB_CONCURRENCY=2
PORT=8000

# Optional authenticated OpenTelemetry/Phoenix profile. Business readiness does
# not depend on these services. Keep disabled until both host-only files exist.
CIVICLOOP_OBSERVABILITY_ENABLED=false
CIVICLOOP_TELEMETRY_ENABLED=false
CIVICLOOP_TELEMETRY_ENDPOINT=
CIVICLOOP_TELEMETRY_HEADERS_FILE=
CIVICLOOP_TELEMETRY_SERVICE_NAME=civicloop
CIVICLOOP_PHOENIX_ENV_HOST_PATH=/srv/civicloop/secrets/phoenix.env
CIVICLOOP_PHOENIX_OTLP_HEADERS_HOST_PATH=/srv/civicloop/secrets/phoenix-otlp-headers

# Optional self-hosted model-gateway profile. Keep disabled until the pinned
# image signature and production secret-file gates have been verified.
CIVICLOOP_MODEL_GATEWAY_ENABLED=false
CIVICLOOP_MODEL_GATEWAY_CREDENTIAL_FILE=/srv/civicloop/secrets/litellm-provider-credential
CIVICLOOP_MODEL_GATEWAY_MASTER_KEY_FILE=/srv/civicloop/secrets/litellm-master-key
CIVICLOOP_MODEL_GATEWAY_TOKEN_FILE=/srv/civicloop/secrets/model-gateway-token
CIVICLOOP_MODEL_GATEWAY_UPSTREAM_MODEL=openai/gpt-4.1-mini
CIVICLOOP_MODEL_GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
